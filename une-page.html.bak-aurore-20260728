<script>
(() => {
  'use strict';

  /* ════════════════════════════════════════════════════════════════════════
     À REMPLIR
     ══════════════════════════════════════════════════════════════════════ */

  /* Lien d'embed de la VSL. Vide = le clic affiche le bloc « emplacement ».
     Ex : 'https://www.youtube.com/embed/XXXXXXXXXXX?autoplay=1&rel=0&modestbranding=1' */
  const VSL_EMBED_URL = '';
  const VSL_DUREE = '12:04'; /* durée réelle affichée sur la façade */

  /* Témoignages clients, affichés les uns sous les autres.
     Chaque entrée accepte SOIT une capture (`capture`), SOIT une vidéo portrait
     (`video` plus `poster`), qui tourne en boucle et sans son.
     `role` donne le contexte : c'est lui qui rend le témoignage crédible. */
  const PREUVES = [
    { nom: 'Adam Younes', role: '', resultat: '40K en 4 mois', capture: null }, // ex: 'assets/proofs/adam.webp'
    { nom: 'Yassine',     role: '', resultat: 'de 5k à 15k',   capture: null },
    { nom: 'Yanis',       role: '', resultat: '10k/mois',      capture: null },
    { nom: 'Benjamin',    role: '', resultat: '5K/mois',       capture: null },
    { nom: 'Isac',        role: '', resultat: '7k/mois',       capture: null },
    { nom: 'Walid',       role: '', resultat: '12k/mois',      capture: null },
    { nom: 'Natannël',    role: '', resultat: '4,2k/mois',     capture: null },
    { nom: 'Ibrahim',     role: '', resultat: '9k/mois',       capture: null },
    { nom: 'Ilyes',       role: '', resultat: '6k/mois',       capture: null },
    { nom: 'Celio',       role: '', resultat: '15k/mois',      capture: null },
    { nom: 'Wassim',      role: '', resultat: '8k/mois',       capture: null },
    { nom: 'Léo',         role: '', resultat: '11k/mois',      capture: null },
    { nom: 'Bastien',     role: '', resultat: '6,8k/mois',     capture: null },
    { nom: 'Alexis',      role: '', resultat: '20k en 3 mois', capture: null },
    { nom: 'Manda',       role: '', resultat: '7,4k/mois',     capture: null },
    { nom: 'Noman',       role: '', resultat: '10k/mois',      capture: null }
  ];

  /* AVANT MISE EN LIGNE : passer à true. Une carte sans capture est une preuve
     vide, et une preuve vide détruit la confiance d'un profil sceptique. */
  const MASQUER_PREUVES_SANS_CAPTURE = false;

  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Les états d'entrée ne s'arment que si le script tourne vraiment. */
  if (!reduit) document.documentElement.classList.add('js');

  /* ══ Logo : bascule dès que le fichier est déposé ══════════════════════ */

  const logo = document.getElementById('logo');
  if (logo) {
    const test = new Image();
    test.onload = () => {
      logo.innerHTML = '';
      const img = new Image();
      img.className = 'slot-img';
      img.src = 'assets/logo.png';
      img.alt = 'Reset Ultra';
      img.width = 40; img.height = 40;
      logo.appendChild(img);
    };
    test.src = 'assets/logo.png';
  }

  /* ══ Hero : révélation ligne par ligne ════════════════════════════════ */

  const heroInner = document.getElementById('hero-inner');

  const lancerHero = () => {
    if (!heroInner) return;
    requestAnimationFrame(() => {
      heroInner.classList.add('is-in');
      poserFaisceau();
    });
  };

  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(lancerHero);
    setTimeout(() => { if (heroInner && !heroInner.classList.contains('is-in')) lancerHero(); }, 1200);
  } else {
    lancerHero();
  }

  let redim;
  window.addEventListener('resize', () => {
    clearTimeout(redim);
    redim = setTimeout(poserFaisceau, 200);
  });

  /* ══ Mur de preuves ═══════════════════════════════════════════════════ */

  const carte = (p, clone) => {
    const el = document.createElement('div');
    el.className = 'proof';
    if (clone) el.setAttribute('aria-hidden', 'true');

    const shot = document.createElement('div');
    shot.className = 'proof-shot';
    if (p.video) {
      // Témoignage filmé : il tourne en boucle, sans son, sans commande.
      const v = document.createElement('video');
      v.src = p.video;
      if (p.poster) v.poster = p.poster;
      v.muted = true; v.defaultMuted = true;
      v.loop = true; v.autoplay = true;
      v.playsInline = true; v.setAttribute('playsinline', '');
      v.preload = 'metadata';
      v.className = 'slot-img';
      v.setAttribute('aria-label', 'Témoignage de ' + p.nom);
      shot.appendChild(v);
    } else if (p.capture) {
      const img = document.createElement('img');
      img.className = 'slot-img';
      img.src = p.capture;
      img.alt = 'Résultat de ' + p.nom + ' : ' + p.resultat;
      img.loading = 'lazy';
      img.decoding = 'async';
      shot.appendChild(img);
    } else {
      const ph = document.createElement('div');
      ph.className = 'slot';
      ph.textContent = 'Capture';
      shot.appendChild(ph);
    }

    const meta = document.createElement('div');
    meta.className = 'proof-meta';
    const ident = document.createElement('div');
    ident.className = 'proof-id';
    const nom = document.createElement('span');
    nom.className = 'proof-name';
    nom.textContent = p.nom;
    ident.appendChild(nom);
    if (p.role) {
      const role = document.createElement('span');
      role.className = 'proof-role';
      role.textContent = p.role;
      ident.appendChild(role);
    }
    const res = document.createElement('span');
    res.className = 'proof-result';
    res.textContent = p.resultat;
    meta.append(ident, res);

    el.append(shot, meta);
    return el;
  };

  const visibles = MASQUER_PREUVES_SANS_CAPTURE ? PREUVES.filter(p => p.capture || p.video) : PREUVES;
  const pile = document.getElementById('stack');
  if (!visibles.length) {
    const section = document.getElementById('preuves');
    if (section) section.remove();
  } else if (pile) {
    visibles.forEach(p => pile.appendChild(carte(p, false)));
  }


  /* ══ Vidéo : façade, l'embed ne charge qu'au clic ═════════════════════ */

  const tempsEl = document.getElementById('player-time');
  if (tempsEl) tempsEl.textContent = VSL_DUREE;

  const playBtn = document.getElementById('play-btn');
  if (playBtn) {
    // Bouton magnétique : 6 px maximum, juste assez pour se sentir vivant.
    const dot = playBtn.querySelector('.play-dot');
    if (!reduit && dot && window.matchMedia('(hover: hover)').matches) {
      playBtn.addEventListener('pointermove', e => {
        const r = playBtn.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
        const dy = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
        dot.style.transform = 'translate(' + (dx * 6).toFixed(1) + 'px,' + (dy * 6).toFixed(1) + 'px)';
      });
      playBtn.addEventListener('pointerleave', () => { dot.style.transform = 'none'; });
    }

    playBtn.addEventListener('click', () => {
      const player = document.getElementById('player');
      player.innerHTML = '';

      player.style.aspectRatio = '16 / 9'; // le lecteur reprend son format
      if (VSL_EMBED_URL) {
        const frame = document.createElement('iframe');
        frame.src = VSL_EMBED_URL;
        frame.title = 'Reset Ultra, la vidéo';
        frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share';
        frame.allowFullscreen = true;
        player.appendChild(frame);
        frame.focus();
        return;
      }

      const note = document.createElement('div');
      note.className = 'player-note';
      const kicker = document.createElement('span');
      kicker.className = 'kicker';
      kicker.textContent = 'EMPLACEMENT VIDÉO';
      const txt = document.createElement('p');
      txt.textContent = "Le lecteur réel se charge ici au clic. Renseigne VSL_EMBED_URL avec le lien de la VSL, ce bloc devient l'embed.";
      note.append(kicker, txt);
      player.appendChild(note);
    });
  }

  /* ══ Secours iClosed : seulement si le widget n'a pas monté ═══════════
     La hauteur réservée n'est JAMAIS réduite : un repli qui remonte 500px de
     contenu compterait comme un décalage de mise en page. */

  (() => {
    const mount = document.getElementById('iclosed-mount');
    const fallback = document.getElementById('iclosed-fallback');
    if (!mount || !fallback) return;
    const minuteur = setTimeout(() => { fallback.style.display = 'block'; }, 8000);
    if (mount.querySelector('iframe')) { clearTimeout(minuteur); return; }
    if (!('MutationObserver' in window)) return;
    // Dès que le widget monte son iframe, le secours n'a plus lieu d'être.
    const mo = new MutationObserver(() => {
      if (!mount.querySelector('iframe')) return;
      clearTimeout(minuteur);
      fallback.style.display = 'none';
      mo.disconnect();
    });
    mo.observe(mount, { childList: true, subtree: true });
  })();

  /* ══ Faisceau : mesuré, donc juste à toutes les largeurs ══════════════ */

  const beam = document.getElementById('beam');
  const panneau = document.getElementById('booking');
  const tuile = document.getElementById('logo');

  const poserFaisceau = () => {
    if (!beam || !panneau || !tuile) return;
    // Sous 1200px, le titre centré passerait dessous : pas de faisceau.
    if (window.innerWidth < 1200) { beam.style.display = 'none'; return; }
    const hautPanneau = panneau.getBoundingClientRect().top + window.scrollY;
    const basTuile = tuile.getBoundingClientRect().bottom + window.scrollY;
    const h = Math.round(hautPanneau - basTuile);
    if (h < 80) { beam.style.display = 'none'; return; }
    beam.style.height = h + 'px';
    beam.style.display = 'block';
  };
  poserFaisceau();
  window.addEventListener('load', poserFaisceau);

  /* ══ Reveal au scroll ═════════════════════════════════════════════════ */

  const cibles = document.querySelectorAll('[data-reveal]');
  const toutAfficher = () => cibles.forEach(el => el.classList.add('shown'));

  if (reduit || !('IntersectionObserver' in window)) {
    toutAfficher();
  } else {
    const filet = setTimeout(toutAfficher, 3000);
    let restants = cibles.length;
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        restants--;
        e.target.classList.add('shown');
        obs.unobserve(e.target);
      });
      if (restants <= 0) { clearTimeout(filet); obs.disconnect(); }
    }, { threshold: .12, rootMargin: '0px 0px -8% 0px' });
    cibles.forEach(el => io.observe(el));
  }
})();
</script>
</body>
