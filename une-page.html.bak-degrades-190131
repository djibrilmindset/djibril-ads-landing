/* ══ Polices ══════════════════════════════════════════════════════════════ */
@font-face{font-family:'Bricolage Grotesque';src:url(data:font/woff2;base64,) format('woff2');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'Bricolage Grotesque';src:url(data:font/woff2;base64,) format('woff2');font-weight:500;font-style:normal;font-display:swap}
