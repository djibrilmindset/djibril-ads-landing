@font-face{font-family:'Bricolage Grotesque';src:url(data:font/woff2;base64,) format('woff2');font-weight:800;font-style:normal;font-display:swap}

/* RU-1P-DIFF · fonts-reelles : Departure Mono (active var(--mono) tel quel)
   + Instrument Serif Italic latin & latin-ext (memes unicode-range que
   premium.html) — chemins relatifs fonts/, preload dans le <head>. */
@font-face{font-family:'Departure Mono';src:url('fonts/departure.woff2') format('woff2');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'Instrument Serif';src:url('fonts/instrument-serif-italic-400-latin.woff2') format('woff2');font-weight:400;font-style:italic;font-display:swap;unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:'Instrument Serif';src:url('fonts/instrument-serif-italic-400-latin-ext.woff2') format('woff2');font-weight:400;font-style:italic;font-display:swap;unicode-range:U+0100-024F,U+0259,U+1E00-1EFF,U+2020,U+20A0-20AB,U+20AD-20BF,U+2113,U+2C60-2C7F,U+A720-A7FF}

/* ══ Tokens ═══════════════════════════════════════════════════════════════ */
:root{
  --bg:#FAFAF7;--card:#FFFFFF;--hair:#E7E6E0;--ink-panel:#120C1F;
  --ink:#0F0E12;--ink-soft:#2A2830;--ink-mute:#6B6870;--on-dark:#F4F1F8;
  --glow:#b57bff;--violet:#8b5cf6;--violet-deep:#6d28d9;--violet-ink:#3b1a6e;
  --sans:'Bricolage Grotesque',ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;
  --mono:'Departure Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
  --ease-in-out:cubic-bezier(.16,1,.3,1);
  --ease-micro:cubic-bezier(.22,.7,.3,1);
  /* Largeur utile du lockup. Toutes les tailles du hero en découlent, donc le
     bloc scale comme une image et garde le même assemblage à toute largeur. */
  --lock:min(1180px,100vw - 36px);
}
@media(min-width:1000px){:root{--lock:min(1180px,100vw - 40px)}}

/* ══ Base ═════════════════════════════════════════════════════════════════ */
*{box-sizing:border-box}
/* clip en plus de hidden : sur iOS, hidden seul ne coupe pas de façon fiable. */
html,body{overflow-x:hidden;overflow-x:clip}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font-family:var(--sans);font-size:16px;line-height:1.55;font-weight:400;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
}
/* tabular-nums sur les instruments de mesure seulement : dans un display 800,
   les chiffres tabulaires se désolidarisent des bas de casse. */
.proof-result,.player-time,.trust{font-variant-numeric:tabular-nums}
img{display:block;max-width:100%}
a{color:var(--violet-deep);text-decoration:none}
a:hover{color:var(--violet-ink)}
::selection{background:rgba(181,123,255,.25)}
button:focus-visible,a:focus-visible{outline:2px solid var(--violet-deep);outline-offset:3px}

@keyframes spin1{to{transform:rotate(360deg)}}
@keyframes twinkle{0%,100%{opacity:.34}50%{opacity:.06}}

/* ══ Emplacements images ══════════════════════════════════════════════════ */
.slot{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  text-align:center;padding:8px;background:rgba(181,123,255,.06);
  border:1px dashed rgba(109,40,217,.3);color:var(--violet-ink);
  font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;
}
.slot-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}

/* ══ Page ═════════════════════════════════════════════════════════════════ */
.page{position:relative;width:100%;overflow:hidden}
.grain{
  position:fixed;inset:0;pointer-events:none;z-index:60;opacity:.04;
  background-image:url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22160%22 height=%22160%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%224%22/></filter><rect width=%22160%22 height=%22160%22 filter=%22url(%23n)%22/></svg>');
}
.wrap{max-width:1180px;margin:0 auto}

/* ── Barre haute ──────────────────────────────────────────────────────────
   Posée PAR DESSUS le hero et non au dessus de lui : sinon elle laisse une
   bande claire en haut de page, où les rayons ne montent pas. */
.topbar{
  position:absolute;top:0;left:0;right:0;z-index:30;height:56px;
  padding:0 20px;padding-top:env(safe-area-inset-top);
  /* Logo centré sur l'axe du titre (demande 28/07) : le faisceau descend
     du logo vers le panneau en traversant l'accroche, comme la référence. */
  display:flex;align-items:center;justify-content:center;
}
.logo{
  position:relative;width:42px;height:42px;border-radius:12px;overflow:hidden;
  box-shadow:0 8px 22px -10px rgba(109,40,217,.75);
}
.logo svg{display:block;width:100%;height:100%}
.logo .slot-img{object-fit:cover}

/* ── Hero ─────────────────────────────────────────────────────────────── */
.hero{position:relative;padding:58px 20px 18px;overflow:clip}
.fx{position:absolute;pointer-events:none}
/* RU-1P-AURORE-RETIREE : anneau, trame de points, lavis, voile et couche
   vidéo supprimés (28/07). Le hero tient désormais par la typographie seule. */
.star{border-radius:50%}
.star-1{left:19%;top:34%;width:3px;height:3px;background:var(--glow);box-shadow:0 0 10px 2px rgba(181,123,255,.6);animation:twinkle 6s ease-in-out infinite}
.star-2{left:79%;top:24%;width:2px;height:2px;background:var(--violet);box-shadow:0 0 8px 2px rgba(139,92,246,.5);animation:twinkle 8s ease-in-out infinite 1.5s}
.star-3{left:64%;top:62%;width:2.5px;height:2.5px;background:var(--glow);box-shadow:0 0 9px 2px rgba(181,123,255,.5);animation:twinkle 7s ease-in-out infinite 3s}

.hero-inner{position:relative;z-index:2;max-width:1180px;margin:0 auto;text-align:center}
/* RU-1P-SOUSCOUCHE RETIREE : elle protegeait la lisibilite du titre sous
   l'aurore. L'aurore n'existe plus, et son z-index:-1 dans le contexte
   d'empilement de .hero-inner empechait Chrome de peindre les glyphes du
   titre au premier rendu (mesure 28/07 : titre present, mesurable, mais
   invisible tant qu'une mutation de style ne forcait pas un repaint). */
.hero-inner{--eq:18px;--eq-c:rgba(76,29,149,.30)}
.hero-inner::after{
  content:'';position:absolute;z-index:-1;pointer-events:none;
  /* la colonne de lecture fait 880 : les équerres se posent 24px dehors,
     jamais sur la largeur du hero (1180) — sinon elles rouvrent le champ
     visuel que le resserrement du titre avait fermé. */
  left:max(0px,calc(50% - 464px));right:max(0px,calc(50% - 464px));
  top:-14px;bottom:-20px;
  background:
    linear-gradient(var(--eq-c),var(--eq-c)) left  top   /1px var(--eq) no-repeat,
    linear-gradient(var(--eq-c),var(--eq-c)) left  top   /var(--eq) 1px no-repeat,
    linear-gradient(var(--eq-c),var(--eq-c)) right top   /1px var(--eq) no-repeat,
    linear-gradient(var(--eq-c),var(--eq-c)) right top   /var(--eq) 1px no-repeat,
    linear-gradient(var(--eq-c),var(--eq-c)) left  bottom/1px var(--eq) no-repeat,
    linear-gradient(var(--eq-c),var(--eq-c)) left  bottom/var(--eq) 1px no-repeat,
    linear-gradient(var(--eq-c),var(--eq-c)) right bottom/1px var(--eq) no-repeat,
    linear-gradient(var(--eq-c),var(--eq-c)) right bottom/var(--eq) 1px no-repeat;
}
@media(max-width:700px){.hero-inner{--eq:12px}}

/* ── Le lockup ────────────────────────────────────────────────────────────
   Chaque ligne est figée et ne se recompose jamais : la taille est calculée
   à partir de la largeur mesurée de la ligne la plus longue, dans la vraie
   police. Résultat, le titre tient sur 3 lignes et la garantie sur 2, du
   iPhone SE au 1440, exactement comme sur la page de référence.
   Diviseurs mesurés : titre 20.25em, garantie 22.01em, eyebrow 24.52em. */
/* ── RU-1P-TYPO · l'écriture porte le hero, il n'y a plus de décor ──────
   Demande 28/07 : « enlève l'aurore, améliore les caractères d'écriture, la
   sophistication, le côté tech, différenciant, un peu unique ».
   L'accroche devient une LIGNE D'INSTRUMENT : Departure Mono, capitales,
   grande chasse, tenue par deux filets qui la posent sur un axe. C'est le
   contraste mono/display qui fait le « tech », pas un effet. */
/* RU-1P-LISIBILITE (28/07) — « cette écriture, on la voit pas assez, faudrait
   des caractères plus épais ». Departure Mono est une police à trait de pixel :
   elle n'existe QU'EN 400, donc aucune coupe grasse à appeler, et un
   font-weight:700 la ferait simuler (bouillie sur une bitmap). Trois leviers
   réels à la place :
   1. l'épaisseur VRAIE par -webkit-text-stroke + paint-order:stroke fill,
      qui grossit le fût sans déformer le dessin,
   2. l'encre : --violet-deep #6d28d9 (6,7:1) passe à --violet-ink #3b1a6e
      (12,9:1), toujours franchement violet mais deux fois plus dense,
   3. le corps monte de 13 à 14,5px et la chasse se resserre de .155 à .13em,
      pour que la ligne se lise comme un BLOC et non comme des lettres semées. */
.eyebrow{
  margin:0 auto;font-family:var(--mono);font-weight:400;
  font-size:min(14.5px,calc(var(--lock) / 38));
  line-height:1.35;letter-spacing:.13em;text-transform:uppercase;
  color:var(--violet-ink);white-space:nowrap;
  -webkit-text-stroke:.42px currentColor;paint-order:stroke fill;
  display:flex;align-items:center;justify-content:center;gap:.9em;
}
.eyebrow::before,.eyebrow::after{
  content:'';height:1px;width:clamp(18px,4.6vw,54px);flex:none;
  background:linear-gradient(90deg,rgba(59,26,110,0),rgba(59,26,110,.6));
}
.eyebrow::after{background:linear-gradient(270deg,rgba(59,26,110,0),rgba(59,26,110,.6))}
@media(max-width:560px){
  /* mesuré à 390px : nowrap + .155em faisaient tomber l'accroche à 8.4px
     (illisible) et elle débordait quand même de 6px. Deux lignes valent mieux
     qu'une ligne qu'on ne peut pas lire. */
  .eyebrow{white-space:normal;letter-spacing:.09em;font-size:11px;line-height:1.5;
    max-width:min(92vw,340px);display:block}
  .eyebrow::before,.eyebrow::after{display:none}
}
.headline{
  margin:.30em auto 0;
  /* Mesure resserrée (demande 28/07) : colonne centrée confortable,
     l'œil ne balaie plus tout l'écran pour lire.
     ⚠️ Les .ln sont nowrap+overflow:hidden (animation par ligne) : la police
     DOIT tenir la plus longue ligne dans 880px, sinon des mots sont clippés. */
  max-width:min(88vw,880px);
  font-size:min(41px,calc(var(--lock) / 23.5));
  font-weight:800;line-height:1.14;letter-spacing:-.034em;font-size-adjust:.528;color:var(--ink);
  /* RU-1P-TYPO : les montants sont le cœur émotionnel de la phrase. En
     chiffres proportionnels, « 3,000 » et « 5,000 » ne s'alignent pas et le
     zéro flotte. Chiffres tabulaires : ils se tiennent comme un relevé. */
  font-variant-numeric:lining-nums tabular-nums;
  font-feature-settings:'tnum' 1,'lnum' 1;
  /* ⚠️ OBLIGATOIRE avec la ligne du dessus : la page hérite d'un
     text-rendering:optimizeLegibility, et COMBINÉ à un font-feature-settings
     explicite ici, Chrome cesse de peindre les glyphes du titre (mesuré
     28/07 : titre présent et mesurable, mais invisible). */
  text-rendering:auto;
}
/* RU-1P-DIFF · montants-lumiere : degrade riche 3 arrets, cap #8b5cf6 (4.1:1
   AA large sur #FAFAF7 — JAMAIS #b57bff en texte sur clair). Scope
   :not(.hl-serif) : le segment heritage ne recoit ni gradient ni halo. */
.headline .hl:not(.hl-serif){
  background:linear-gradient(92deg,#6d28d9 0%,#7c3aed 45%,#8b5cf6 100%);
  -webkit-background-clip:text;background-clip:text;
  color:transparent;-webkit-text-fill-color:transparent;
}
/* RU-1P-DIFF · halo lumineux desktop only (repaint mobile) — drop-shadow
   marche avec background-clip:text la ou text-shadow peindrait par-dessus. */
@media(min-width:701px){
  .headline .hl:not(.hl-serif){filter:drop-shadow(0 2px 14px rgba(139,92,246,.28))}
}
/* RU-1P-DIFF · AA mobile : ~14.4px poids 800 n'est pas du texte large,
   le stop clair remonte a #7c3aed (5.4:1, conforme 4.5:1). */
@media(max-width:700px){
  /* Le shorthand background: reinitialiserait background-clip a border-box
     (rectangles violets pleins) : re-declarer le clip texte ici. */
  .headline .hl:not(.hl-serif){
    background:linear-gradient(92deg,#6d28d9,#7c3aed);
    -webkit-background-clip:text;background-clip:text;
  }
}
/* RU-1P-DIFF · serif-heritage : Instrument Serif italic, couleur PLEINE
   var(--violet-ink) (12.9:1) — pas de degrade (les montants possedent la
   lumiere), filter:none (le halo montants ne s'applique pas ici). Declare
   APRES les regles montants : ordre source tranche a specificite egale.
   font-size-adjust:none OBLIGATOIRE : le .528 herite gonflerait ~26%. */
/* RU-1P-DIFF — segment héritage : plus large et plus épais pour la lisibilité
   (demande 28/07). Instrument Serif n'a que du 400 : le corps est monté et la
   graisse simulée au trait, sans changer de police. */
.headline .hl-serif{
  font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-weight:400;
  font-size:1.24em;font-size-adjust:none;letter-spacing:.002em;
  -webkit-text-stroke:.55px currentColor;paint-order:stroke fill;
  background:none;color:var(--violet-ink);-webkit-text-fill-color:var(--violet-ink);filter:none;
}
/* RU-1P-DIFF · montants-lumiere : le masque .ln (overflow:hidden) couperait
   le halo au bord de chaque ligne — il ne sert que pendant l'entree, il est
   leve par JS (transitionend + filet) une fois le hero en place. */
.headline .ln.ln-open{overflow:visible}
/* RU-1P-DIFF — même colonne que le titre : la garantie débordait à 1180px
   quand le titre tient dans 880, l'œil devait balayer plus large (demande 28/07). */
.promise{
  margin:.72em auto 0;max-width:min(88vw,880px);
  font-size:min(28px,calc(var(--lock) / 34));
  font-weight:700;line-height:1.4;letter-spacing:-.012em;color:var(--ink);
}
/* RU-1P-DIFF · garantie-marker : surlignage marqueur violet (fond seul, le
   texte reste encre #0F0E12, AA intact). */
/* RU-1P-DIFF — le cœur de la promesse passe en rouge (demande 28/07). */
.garantie-hl{
  color:#E11D48;
  background:linear-gradient(180deg,transparent 62%,rgba(225,29,72,.20) 62%,rgba(225,29,72,.20) 94%,transparent 94%);
  border-radius:2px;
}
/* RU-1P-DIFF · AA mobile : ~10px w700 = texte small (seuil 4.5:1) ; #E11D48
   mesure 4.49:1 nu et 3.28:1 sur la bande marker → #A80F36 (7.2:1 nu,
   5.3:1 sur bande), meme famille que le #C1123C de .fine. */
@media(max-width:700px){
  .garantie-hl{color:#A80F36}
}
/* RU-1P-DIFF · garantie-marker : (sur contrat) en sceau contractuel Departure
   Mono — recette chip E5 portee encre. Plancher 10px : .38em de la promise
   mobile ferait 5px, illisible. */
/* RU-1P-DIFF — la garantie doit SE VOIR (demande 28/07) : rouge contrat,
   plus grande, sur un fond rouge pâle qui l'isole comme une clause.
   ⚠️ Ce commentaire était inséré ENTRE `.promise` et `.fine`, ce qui faisait
   du sélecteur un `.promise .fine` involontaire. Il marchait par accident
   (.fine est bien dans .promise) — remis à plat. */
.fine{
  font-family:var(--mono);font-weight:400;font-size:max(11px,.46em);
  letter-spacing:.1em;text-transform:uppercase;color:#C1123C;
  background:rgba(225,29,72,.09);outline:1.5px solid rgba(225,29,72,.42);outline-offset:-1px;
  padding:.45em .8em;border-radius:.7em;vertical-align:.14em;display:inline-block;
}
/* Le trait qui se tire : dernier temps de l'entrée du hero. */
.hairline{
  width:min(280px,46vw);height:2px;margin:clamp(16px,2.2vw,26px) auto 0;
  background:linear-gradient(90deg,transparent,var(--ink) 22%,var(--ink) 78%,transparent);
  transform-origin:center;
}
/* RU-1P-DIFF — mesuré : en ligne, les étoiles poussaient « +83 résultats
   clients » 44px à droite de l'axe. Empilé, chaque élément est vraiment centré
   (demande 28/07) et le chiffre gagne en présence. */
.trust{
  margin:clamp(12px,1.6vw,18px) auto 0;display:flex;flex-direction:column;align-items:center;
  gap:5px;font-size:13.5px;font-weight:700;letter-spacing:.02em;color:var(--ink-soft);
}
.trust .sep{display:none}
.trust .stars{font-size:15px}
.trust .stars{color:var(--violet-deep);letter-spacing:.06em}
.trust .sep{width:1px;height:12px;background:var(--hair)}

/* ── RU-1P-PARCOURS · le récit, en clôture ──────────────────────────────
   Une colonne étroite (58 caractères par ligne), du texte de lecture et non
   du texte d'annonce : à ce stade de la page, on ne vend plus, on se
   présente. Même grammaire typographique que le hero (accroche mono tenue
   par des filets, équerres) pour que la page se lise comme un seul objet. */
.parcours{position:relative;z-index:2;padding:clamp(64px,7vw,110px) 20px clamp(48px,5vw,80px)}
.parcours-in{max-width:min(92vw,620px);margin:0 auto;text-align:center;position:relative}
.parcours-in::after{
  content:'';position:absolute;z-index:-1;pointer-events:none;
  left:-26px;right:-26px;top:-22px;bottom:-22px;
  --e:16px;--ec:rgba(76,29,149,.26);
  background:
    linear-gradient(var(--ec),var(--ec)) left  top   /1px var(--e) no-repeat,
    linear-gradient(var(--ec),var(--ec)) left  top   /var(--e) 1px no-repeat,
    linear-gradient(var(--ec),var(--ec)) right top   /1px var(--e) no-repeat,
    linear-gradient(var(--ec),var(--ec)) right top   /var(--e) 1px no-repeat,
    linear-gradient(var(--ec),var(--ec)) left  bottom/1px var(--e) no-repeat,
    linear-gradient(var(--ec),var(--ec)) left  bottom/var(--e) 1px no-repeat,
    linear-gradient(var(--ec),var(--ec)) right bottom/1px var(--e) no-repeat,
    linear-gradient(var(--ec),var(--ec)) right bottom/var(--e) 1px no-repeat;
}
.parcours-kicker{
  margin:0 auto;font-family:var(--mono);font-size:13.5px;font-weight:400;
  letter-spacing:.13em;text-transform:uppercase;color:var(--violet-ink);
  -webkit-text-stroke:.42px currentColor;paint-order:stroke fill;
  display:flex;align-items:center;justify-content:center;gap:.9em;
}
.parcours-kicker::before,.parcours-kicker::after{
  content:'';height:1px;flex:1;max-width:52px;
  background:linear-gradient(90deg,rgba(59,26,110,0),rgba(59,26,110,.6));
}
.parcours-kicker::after{background:linear-gradient(270deg,rgba(59,26,110,0),rgba(59,26,110,.6))}
.parcours-titre{
  /* mesuré : à 16ch le titre tombait sur 4 lignes et se lisait comme une
     colonne. 21ch le pose sur 3 lignes, mieux tenues. */
  margin:.75em auto 0;max-width:21ch;
  font-size:clamp(25px,3.6vw,38px);font-weight:800;line-height:1.16;
  letter-spacing:-.028em;color:var(--ink);
  font-variant-numeric:lining-nums tabular-nums;text-rendering:auto;
}
/* les durées sont l'argument : elles se lisent comme un relevé, pas comme
   une figure de style */
.pc-nb{font-family:var(--mono);font-weight:400;font-size:.9em;letter-spacing:.01em;
  color:var(--violet-deep);white-space:nowrap}
/* RU-1P-LISIBILITE (28/07) — « l'écriture grise, on la voit pas assez, on a
   du mal à lire ». Mesuré : --ink-soft #2A2830 sur #FAFAF7 donne pourtant
   13,98:1, très au-dessus des 4,5:1 exigés. Le problème n'était donc PAS le
   contraste mais le POIDS DE TRAIT : Bricolage Grotesque en 400 à 16,5px a
   des fûts fins, et sur un fond très clair un trait fin se lit gris même à
   14:1. Trois leviers, dans cet ordre :
   1. encre pleine #0F0E12 (18,39:1) au lieu du gris d'encre,
   2. coupe 500 au lieu de 400 (c'est une VRAIE coupe du fichier, pas une
      graisse simulée : Bricolage est embarqué en 400/500/700/800),
   3. corps 17px.
   Un contraste qui passe la norme n'est pas une preuve de lisibilité. */
.parcours-texte{
  margin:clamp(26px,3vw,38px) auto 0;max-width:min(92vw,560px);
  text-align:left;font-size:17px;font-weight:500;line-height:1.7;color:var(--ink);
}
.parcours-texte p{margin:0 0 1.05em}
.parcours-texte p:last-child{margin-bottom:0}
/* ── Les trois marques de lecture. UNE SEULE par phrase : trois marques dans
   un même paragraphe, ce n'est plus de la hiérarchie, c'est du confetti, et
   l'œil ne sait plus où se poser. ── */
/* 1. la phrase porteuse : coupe 800, encre pleine */
.pc-cle{font-weight:800;color:var(--ink)}
/* 2. le point de bascule : surligneur violet, bande basse seulement, le texte
      reste en encre pleine donc le contraste ne bouge pas */
.pc-marque{
  color:var(--ink);font-weight:700;
  background:linear-gradient(180deg,rgba(124,58,237,0) 64%,rgba(124,58,237,.26) 64%,rgba(124,58,237,.26) 96%,rgba(124,58,237,0) 96%);
  border-radius:2px;padding:0 .12em;
}
/* 3. les chiffres : mono violet (déclaré plus haut avec .pc-nb) */
.pc-fort{color:var(--ink);font-weight:700}
.pc-cite{
  margin:1.7em 0;padding:0 0 0 18px;border-left:2px solid rgba(124,58,237,.42);
  font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-weight:400;
  font-size:21px;line-height:1.42;letter-spacing:.002em;color:var(--violet-ink);
}
.pc-fin{color:var(--ink);font-weight:600}
.pc-cta{
  display:inline-block;margin:clamp(26px,3vw,36px) auto 0;padding:1em 1.7em;
  font-family:var(--mono);font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;
  color:#FAFAF7;background:var(--ink);border-radius:.85em;text-decoration:none;
  box-shadow:0 10px 26px -12px rgba(15,13,20,.55);
  transition:transform .22s var(--ease-micro,ease),box-shadow .22s ease,background .22s ease;
}
.pc-cta:hover{background:#000;transform:translateY(-1px);box-shadow:0 14px 32px -12px rgba(15,13,20,.62)}
.pc-cta:focus-visible{outline:2px solid var(--violet-deep);outline-offset:3px}
@media(max-width:560px){
  .parcours-in::after{left:-14px;right:-14px;--e:11px}
  .parcours-kicker{font-size:11px;letter-spacing:.1em}
  .parcours-kicker::before,.parcours-kicker::after{max-width:26px}
  .parcours-texte{font-size:16px;line-height:1.7}
  .pc-cite{font-size:19px}
}

/* ── RU-1P-TEMOIGNAGES · vignette, puis lecteur au clic ─────────────────
   Les 83 témoignages sont des vidéos verticales. La vignette est portrait :
   un cadre 4/3 en couperait la moitié. Une fois lancé, le cadre passe en
   9/16 pour que le lecteur Wistia n'ait rien à letterboxer. */
/* un seul gabarit, vignette comme lecteur : la carte ne bouge pas au clic */
.stack .proof-shot{position:relative;background:#EDE9F5}
.proof-play{
  display:block;width:100%;height:100%;padding:0;border:0;background:none;
  cursor:pointer;position:relative;
}
.proof-play .slot-img{width:100%;height:100%;object-fit:cover;display:block}
.proof-play-dot{
  position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:46px;height:46px;border-radius:50%;display:grid;place-items:center;
  background:rgba(124,58,237,.92);color:#fff;font-size:17px;padding-left:3px;
  box-shadow:0 6px 22px rgba(46,16,84,.38),0 0 0 1px rgba(255,255,255,.28) inset;
  transition:transform .25s var(--ease-out,ease),background .25s ease;
}
.proof-play:hover .proof-play-dot{transform:translate(-50%,-50%) scale(1.07);background:rgba(109,40,217,.96)}
.proof-frame{width:100%;height:100%;border:0;display:block}
/* RU-1P-DIFF — demande 28/07 : « le CTA des témoignages doit être TRÈS
   visible, et en noir, vu que c'est sur fond blanc ». Un bouton fantôme
   violet clair sur #FAFAF7 se lisait comme une note de bas de page ; ici
   c'est un bouton plein encre, sur toute la largeur de la colonne, avec le
   compte dedans. Contraste texte/fond 17,4:1. */
.proof-plus{
  display:block;width:100%;margin:20px auto 0;padding:1.05em 1.2em;cursor:pointer;
  font-family:var(--mono);font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;
  color:#FAFAF7;background:var(--ink);border:0;border-radius:.85em;
  box-shadow:0 10px 26px -12px rgba(15,13,20,.55);
  transition:transform .22s var(--ease-micro,ease),box-shadow .22s ease,background .22s ease;
}
.proof-plus:hover{background:#000;transform:translateY(-1px);box-shadow:0 14px 32px -12px rgba(15,13,20,.62)}
.proof-plus:active{transform:translateY(0)}
.proof-plus:focus-visible{outline:2px solid var(--violet-deep);outline-offset:3px}

/* ── RU-1P-VITRINE · les visages des clients défilent sous le compteur ──
   Demande 28/07 : « la tête de mes clients qui défile de droite à gauche,
   des petits cadres, pas trop épais, un beau contraste, que ça fasse tech ».
   75 visages recadrés SUR LE VISAGE depuis les vignettes Wistia (détection
   OpenCV, rattrapage par extraction de frame dans la vidéo quand la vignette
   ne montrait pas de visage). Les 8 dont le visage n'est pas exploitable
   — cagoule, floutage, hors champ, image noire — sont écartés : une case
   vide dans une vitrine détruit la preuve qu'elle est censée porter.
   Coût : un seul transform sur la piste, zéro repeinture. La piste porte
   deux lots identiques et se décale d'exactement un lot, la boucle est donc
   invisible. Le décalage est MESURÉ en JS, jamais deviné en pourcentage :
   avec un gap, -50% tombe systématiquement à côté et la vitrine saute. */
.vitrine{
  --tuile:62px; --pas:10px;
  margin:clamp(18px,2.4vw,26px) auto 0;
  /* même colonne que le titre (880px) : la vitrine ne doit pas élargir le
     champ de lecture, l'œil reste au centre */
  /* la vitrine doit tenir DANS les équerres (2×464 = 928) : à 940 elle
     mordait sur les coins bas (constaté 28/07). Même colonne que le titre. */
  width:100%;max-width:min(88vw,880px);
  position:relative;overflow:hidden;
  padding:9px 0;border-radius:20px;
  /* la vitrine est une glissière ENCASTRÉE : léger creux violet + arête
     haute sombre. C'est ce contraste qui fait ressortir les visages sur un
     fond blanc cassé — sans lui, les tuiles claires se noient dans la page. */
  background:
    linear-gradient(180deg,rgba(109,40,217,.10),rgba(109,40,217,.045) 42%,rgba(109,40,217,.09));
  box-shadow:
    inset 0 1px 2px rgba(46,16,84,.20),
    inset 0 -1px 0 rgba(255,255,255,.65),
    0 1px 0 rgba(255,255,255,.9);
  /* les visages naissent et meurent dans le fond, jamais sur un bord net */
  -webkit-mask:linear-gradient(90deg,#0000,#000 7%,#000 93%,#0000);
          mask:linear-gradient(90deg,#0000,#000 7%,#000 93%,#0000);
}
.vitrine-piste{display:flex;gap:var(--pas);width:max-content;
  animation:vitrine-defile var(--duree,110s) linear infinite}
.vitrine-lot{display:flex;gap:var(--pas)}
.vitrine:hover .vitrine-piste,
.vitrine[data-viewport-pause] .vitrine-piste{animation-play-state:paused}
@keyframes vitrine-defile{
  from{transform:translate3d(0,0,0)}
  to{transform:translate3d(calc(var(--course,0px) * -1),0,0)}
}
.vitrine figure{
  margin:0;flex:none;width:var(--tuile);height:var(--tuile);
  border-radius:13px;overflow:hidden;position:relative;background:#ECE7F4;
  /* le « petit cadre » : liseré violet fin, arête haute claire (lecture
     verre), ombre courte. Trois couches d'ombre, aucune bordure : une
     bordure mangerait 2px sur une tuile de 62. */
  box-shadow:
    0 0 0 1px rgba(255,255,255,.92),      /* détache la tuile de la glissière */
    0 0 0 2px rgba(109,40,217,.30),       /* le liseré violet, à l'extérieur */
    inset 0 1px 0 rgba(255,255,255,.5),
    0 3px 7px rgba(46,16,84,.16);
}
.vitrine img{width:100%;height:100%;object-fit:cover;display:block;
  filter:contrast(1.09) saturate(1.06)}
@media(max-width:700px){.vitrine{--tuile:52px;--pas:8px}}
@media(prefers-reduced-motion:reduce){.vitrine-piste{animation:none}}

/* ── Bloc de conversion : vidéo + iClosed sur un panneau encre ─────────
   C'est le pivot de la page : sur l'encre, la vidéo et la carte blanche du
   formulaire deviennent les deux seuls objets allumés du premier écran. */
.convert{
  position:relative;z-index:2;background:var(--ink-panel);color:var(--on-dark);
  padding:clamp(22px,2.6vw,30px) 20px clamp(74px,7vw,120px);
}
/* Arête haute : un filet de lumière, pas un dégradé. Un dégradé forcerait le
   titre blanc sur du clair. */
.convert::before{
  content:'';position:absolute;left:0;right:0;top:0;height:1px;pointer-events:none;
  background:linear-gradient(90deg,transparent,rgba(181,123,255,.55) 30%,rgba(181,123,255,.55) 70%,transparent);
}
/* Retour au papier par le bas, dans la zone de padding : aucun texte dessus. */
.convert::after{
  content:'';position:absolute;left:0;right:0;bottom:0;height:140px;pointer-events:none;
  background:linear-gradient(0deg,var(--bg),transparent);
}
/* minmax(0,1fr) et non 1fr : sans ça, la ligne en nowrap impose sa largeur
   minimale à la colonne et fait déborder toute la page sur mobile. */
.convert-grid{position:relative;display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(18px,2.2vw,28px);align-items:start}
.video-col,.form-col{min-width:0}
.col-head{
  margin:0 0 12px;font-size:clamp(15px,1.4vw,20px);font-weight:700;line-height:1.3;
  letter-spacing:-.015em;color:#fff;
}
/* Une seule ligne, comme sur la page de référence. Largeur mesurée : 32.83em.
   Sous 380px la ligne passerait sous 10px, on la laisse se replier. Au dessus
   de 1000px la vidéo n'occupe plus toute la largeur : la contrainte n'a plus
   de sens et la ligne se replie naturellement. */
@media(min-width:380px) and (max-width:999px){
  .video-col .vid-head{white-space:nowrap;font-size:min(20px,calc(var(--lock) / 33.6))}
}

/* Le faisceau : il descend de la tuile du logo et vient se poser sur l'arête
   du panneau encre. Sa hauteur est mesurée en JS, donc juste à toute largeur.
   Desktop seulement : plus bas, il croiserait le titre centré. */
/* bottom:100% => le faisceau vit au dessus du panneau et se termine pile sur
   son arête. right:39px => aligné sur le centre de la tuile du logo. */
.beam{position:absolute;bottom:100%;left:calc(50% - 1px);width:2px;height:0;pointer-events:none;z-index:3;display:none}
.beam-line{
  position:absolute;inset:0;border-radius:2px;
  background:linear-gradient(180deg,rgba(109,40,217,0),rgba(109,40,217,.18) 42%,rgba(109,40,217,.62));
}
.beam-glow{
  position:absolute;left:50%;bottom:-14px;width:150px;height:150px;transform:translateX(-50%);
  background:radial-gradient(closest-side,rgba(181,123,255,.5),transparent 72%);
}
.beam-hit{
  position:absolute;left:50%;bottom:-3px;width:7px;height:7px;transform:translateX(-50%);
  border-radius:50%;background:var(--glow);box-shadow:0 0 16px 4px rgba(181,123,255,.75);
}
.player-wrap{position:relative}
/* RU-1P-AURA-ROUGE · demande 28/07 : « que le cadre de la VSL brille, une
   vraie aura qui sort autour et qui se voit vraiment, d'une couleur
   différenciante — rouge ». Le rouge est le seul accent déjà présent sur la
   page (la garantie « Je Te Rembourse »), donc il différencie SANS ouvrir un
   troisième code couleur. Il ne vit que sur la dalle encre, où il ne dispute
   rien au violet du hero.
   L'aura respire en OPACITÉ seule : un scale ferait recalculer le flou de 52px
   à chaque frame. Elle est confinée à .video-col — jamais un ancêtre de la
   carte iClosed (opacity < 1 crée un bloc conteneur pour les position:fixed,
   et le calendrier iClosed en dépend). */
.player-glow{
  position:absolute;inset:-14%;pointer-events:none;
  background:
    radial-gradient(50% 50% at 50% 48%,rgba(255,59,92,.46),transparent 70%),
    radial-gradient(72% 66% at 50% 52%,rgba(225,29,72,.30),transparent 76%);
  filter:blur(52px);
  animation:aura-respire 7s ease-in-out infinite;
}
@keyframes aura-respire{0%,100%{opacity:.82}50%{opacity:1}}
.video-col[data-viewport-pause] .player-glow{animation-play-state:paused}
@media(prefers-reduced-motion:reduce){.player-glow{animation:none;opacity:.9}}
/* RU-1P-DIFF · ecrin-vsl : ecrin E5 dalle sombre — lisere interne currentColor
   14% (fallback rgba AVANT color-mix), glow interne blanc, lueur violette
   calibree dessous, ombre unique. Fini le gradient-border dur.
   Embed/facade au clic INTACTS : seule l'enveloppe change. */
.player-frame{
  position:relative;padding:0;border-radius:1.25rem;color:#F4F2F7;background:transparent;
  outline:1px solid rgba(244,241,248,.14);
  outline:1px solid color-mix(in srgb,currentColor 14%,transparent);
  outline-offset:-1px;
  box-shadow:0 24px 70px -34px rgba(5,3,10,.65),0 0 0 1px rgba(255,59,92,.34),0 0 46px -6px rgba(255,59,92,.55),0 0 108px -18px rgba(225,29,72,.42),0 0 32px 0 rgba(255,255,255,.05) inset,0 0 6px 0 rgba(255,255,255,.04) inset;
}
/* RU-1P-DIFF · ecrin-vsl : lueur sous-dalle (premium.html) — z-index:-1 pour
   passer DERRIERE la dalle (.convert z-index:2 porte le stacking context,
   le -1 reste au-dessus du panneau encre). */
.player-frame::after{
  content:'';position:absolute;left:-16%;right:-16%;bottom:-42%;height:58%;
  pointer-events:none;z-index:-1;
  background:radial-gradient(50% 60% at 50% 100%,rgba(255,59,92,.34),transparent 70%);
  filter:blur(30px);
}
@media(max-width:700px){
  .player-frame::after{bottom:-30%}  /* RU-1P-DIFF : jamais sur la carte iClosed */
}
.player{position:relative;border-radius:1.25rem;overflow:hidden;background:#0f0d14;aspect-ratio:16/9}
.player iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.poster-shade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(15,13,20,.08),rgba(15,13,20,.5))}
.play-btn{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:transparent;border:0;cursor:pointer}
.play-dot{
  display:flex;align-items:center;justify-content:center;
  width:clamp(64px,8vw,88px);aspect-ratio:1;border-radius:50%;
  background:var(--violet-deep);color:#fff;font-size:clamp(18px,2vw,23px);padding-left:5px;
  box-shadow:0 22px 56px -18px rgba(109,40,217,.95);
  transition:background .2s var(--ease-micro),transform .18s var(--ease-micro);
}
.play-btn:hover .play-dot{background:var(--violet)}
.player-time{
  position:absolute;left:14px;bottom:12px;font-family:var(--mono);font-size:11px;
  letter-spacing:.1em;color:#fff;opacity:.85;
}
.player-note{
  position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:12px;background:#0f0d14;color:#fff;text-align:center;padding:24px;
}
.player-note .kicker{font-family:var(--mono);font-size:11px;letter-spacing:.12em;color:var(--glow)}
.player-note p{margin:0;max-width:44ch;font-size:14.5px;line-height:1.6;color:#EDEBF2}

/* RU-1P-DIFF · ecrin-iclosed : meme famille d'ecrin, variante fond clair E5 —
   lisere interne encre 8% (fallback rgba AVANT color-mix), glow interne blanc
   remonte (.55/.35, calibration fond clair premium), radius aligne sur la
   dalle video. overflow:hidden OBLIGATOIRE (clippe ::before au radius) ;
   jamais de contain:layout (overlays fixed du widget, cf. note plus bas). */
.booking-card{
  position:relative;background:var(--card);border:0;border-radius:1.25rem;
  outline:1px solid rgba(15,14,18,.08);
  outline:1px solid color-mix(in srgb,var(--ink) 8%,transparent);
  outline-offset:-1px;
  box-shadow:0 0 32px 0 rgba(255,255,255,.55) inset,0 0 6px 0 rgba(255,255,255,.35) inset,0 30px 70px -50px rgba(59,26,110,.6);
  overflow:hidden;
}
/* RU-1P-DIFF · ecrin-iclosed : arete haute affinee et lumineuse — echo de
   famille avec la dalle video (le faisceau s'arrete a l'accroche depuis le
   28/07, il n'atterrit plus ici). Glow .3 max : la carte de conversion reste
   l'objet le plus calme de la page. */
.booking-card::before{
  content:'';position:absolute;left:0;right:0;top:0;height:2px;z-index:1;
  background:linear-gradient(90deg,var(--glow),var(--violet-deep));
  box-shadow:0 1px 14px rgba(181,123,255,.3);
}
/* Le titre est DANS la carte : elle commence plus haut, donc le formulaire
   dépasse au premier écran, y compris sur mobile. */
.card-head{
  margin:0;padding:15px 18px 13px;border-bottom:1px solid var(--hair);
  font-size:clamp(15px,1.4vw,20px);font-weight:700;line-height:1.3;letter-spacing:-.015em;color:var(--ink);
}
/* Hauteur réservée : le widget ne pousse rien quand il monte.
   Pas de `contain:layout` ici : ça piégerait les overlays position:fixed du
   widget (sélecteur de dates, fuseau) dans une boîte de 720px. */
#iclosed-mount{width:100%;padding:14px 10px 10px;min-height:720px}
.rgpd{
  margin:0;padding:0 18px 14px;font-size:11.5px;line-height:1.5;color:var(--ink-mute);
  -webkit-text-fill-color:var(--ink-mute);
}
.rgpd a{color:var(--violet-deep);-webkit-text-fill-color:var(--violet-deep);text-decoration:underline}
.iclosed-fallback{display:none;padding:0 18px 20px;text-align:center}
.iclosed-fallback p{margin:0;font-size:14.5px;line-height:1.6;color:var(--ink);-webkit-text-fill-color:var(--ink)}
.iclosed-fallback a{color:var(--violet-deep);-webkit-text-fill-color:var(--violet-deep);font-weight:700;text-decoration:underline}

/* ── Preuves ──────────────────────────────────────────────────────────── */
.proofs{position:relative;z-index:2;padding:0 0 clamp(64px,6vw,100px)}
/* RU-1P-DIFF — l'œil reste au centre (demande 28/07) : le titre de section
   était calé à gauche sur 1180px alors que la pile de témoignages est une
   colonne centrée de 520. On ramène le titre sur le même axe, et on le tient
   entre deux filets, comme l'accroche du hero — même grammaire, donc la page
   se lit comme un seul objet. */
.proofs-head{max-width:min(92vw,560px);margin:0 auto;padding:0 20px 22px;text-align:center}
.proofs-head h2{
  margin:0;font-size:clamp(19px,2.3vw,30px);font-weight:800;letter-spacing:-.025em;color:var(--ink);
  display:flex;align-items:center;justify-content:center;gap:.7em;
}
.proofs-head h2::before,.proofs-head h2::after{
  content:'';height:1px;flex:1;max-width:56px;
  background:linear-gradient(90deg,transparent,rgba(15,14,18,.24));
}
.proofs-head h2::after{background:linear-gradient(270deg,transparent,rgba(15,14,18,.24))}
/* RU-1P-DIFF · temoignages-pile : ecrin famille petites cartes (variante fond
   clair E5) — lisere interne encre 8% (fallback rgba AVANT color-mix), glow
   interne blanc, ombre portee unique. */
.proof{
  width:262px;flex:none;background:var(--card);border:0;border-radius:1.15rem;overflow:hidden;
  outline:1px solid rgba(15,14,18,.08);
  outline:1px solid color-mix(in srgb,var(--ink) 8%,transparent);
  outline-offset:-1px;
  box-shadow:0 0 32px 0 rgba(255,255,255,.55) inset,0 0 6px 0 rgba(255,255,255,.35) inset,0 24px 70px -34px rgba(11,7,16,.2);
}
.proof-shot{position:relative;width:100%;aspect-ratio:4/3;background:#F2F0EB}
.proof-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 13px;border-top:1px solid var(--hair)}
.proof-id{display:flex;flex-direction:column;gap:1px;min-width:0}
.proof-name{font-size:14px;font-weight:700;letter-spacing:-.015em;color:var(--ink)}
.proof-role{font-size:11.5px;font-weight:500;color:var(--ink-soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.proof-result{
  flex:none;font-size:12px;font-weight:700;letter-spacing:-.01em;color:var(--violet-ink);
  background:rgba(181,123,255,.16);padding:5px 8px;border-radius:7px;
}

/* ── Témoignages empilés ──────────────────────────────────────────────── */
/* RU-1P-DIFF · temoignages-pile : colonne centree ETROITE (520px), cartes
   verticales un-a-la-fois a TOUTES les largeurs — fini le split
   image-gauche/texte-droite qui fait bifurquer l'oeil. */
.stack{
  /* RU-1P-TEMOIGNAGES — demande 28/07 : petit cadre, pas un lecteur plein
     format. 300px de colonne = ~264px de vidéo verticale : on voit le visage
     et on lit les sous-titres, et le plein écran reste offert par le lecteur
     Wistia pour qui veut. Une colonne à 520 donnait une carte de 693px de
     haut : neuf de ces cartes, c'est 6 écrans de défilement avant le bas. */
  max-width:min(92vw,300px);margin:clamp(26px,3vw,40px) auto 0;padding:0 20px;
  display:flex;flex-direction:column;gap:clamp(14px,1.8vw,20px);
}
.stack .proof{width:100%;display:flex;align-items:stretch;flex-direction:column}
.stack .proof-shot{width:100%;flex:none;aspect-ratio:9/16;border-right:0;border-bottom:1px solid var(--hair)}
.stack .proof-meta{flex:1;flex-direction:column;align-items:center;text-align:center;justify-content:center;gap:6px;border-top:0;padding:14px 16px}
.stack .proof-name{font-size:15px}
@media(max-width:560px){
  .stack{padding:0 16px}
}
@media(hover:hover){
  .proof,.tvid{transition:transform .25s var(--ease-micro),box-shadow .25s var(--ease-micro)}
  .proof:hover,.tvid:hover{transform:translateY(-4px);box-shadow:0 22px 44px -26px rgba(139,92,246,.55)}
}

/* ── Panneau encre : questions puis garantie ──────────────────────────── */
.slab{position:relative;z-index:2;background:var(--ink-panel);color:var(--on-dark);overflow:hidden}
.slab::before{
  content:'';position:absolute;left:0;right:0;top:0;height:110px;pointer-events:none;
  background:linear-gradient(180deg,var(--bg),transparent);
}
.slab-ray{
  position:absolute;right:-12%;top:-40%;width:760px;height:760px;pointer-events:none;
  background:conic-gradient(from 120deg at 50% 50%,transparent 0deg,rgba(181,123,255,.3) 16deg,transparent 36deg,transparent 150deg,rgba(139,92,246,.22) 170deg,transparent 190deg);
  filter:blur(70px);animation:spin1 140s linear infinite;
}
.slab-inner{position:relative;max-width:1180px;margin:0 auto;padding:clamp(56px,6vw,96px) 20px clamp(48px,5vw,80px)}
.faq h2{
  margin:0 0 clamp(20px,2.4vw,30px);font-size:clamp(21px,2.6vw,34px);font-weight:800;
  letter-spacing:-.03em;color:#fff;
}
.qa{border-top:1px solid rgba(244,241,248,.14);padding:clamp(14px,1.6vw,20px) 0;max-width:820px}
.qa:last-of-type{border-bottom:1px solid rgba(244,241,248,.14)}
.qa h3{margin:0 0 6px;font-size:clamp(15.5px,1.5vw,19px);font-weight:700;letter-spacing:-.018em;color:#fff}
.qa p{margin:0;font-size:clamp(14.5px,1.15vw,16px);line-height:1.62;color:rgba(244,241,248,.86)}

.guarantee{margin-top:clamp(46px,5vw,76px);display:flex;gap:clamp(20px,3.4vw,44px);align-items:flex-start;flex-wrap:wrap}
.seal{
  flex:none;width:104px;height:104px;border-radius:50%;
  border:1.5px solid rgba(181,123,255,.5);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;
  background:radial-gradient(closest-side,rgba(181,123,255,.22),transparent);color:#fff;
}
.seal-n{font-size:33px;font-weight:800;line-height:1;letter-spacing:-.04em}
.seal-u{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em}
.guarantee-body{flex:1;min-width:270px}
.guarantee-body h2{
  margin:0 0 14px;max-width:22ch;font-size:clamp(22px,3.2vw,42px);font-weight:800;
  line-height:1.15;letter-spacing:-.032em;color:#fff;
}
.guarantee-body h2 .hl{color:var(--glow)}
.guarantee-body p{margin:0 0 18px;max-width:60ch;font-size:clamp(14.5px,1.15vw,16px);line-height:1.62;color:rgba(244,241,248,.86)}
/* RU-1P-DIFF (28/07) — « retire le voir conditions, ça sert à rien, et mets le
   CTA un peu plus en encadré ». Le lien nu se lisait comme une note ; il
   devient le seul objet cliquable du bloc, cadré et plein.
   ⚠️ Le renvoi aux conditions ne DISPARAÎT pas de la page : la phrase juste
   au-dessus dit « sur contrat », et le pied de page garde le lien Mentions
   légales plus la mention que les résultats ne sont pas une garantie de
   revenus. C'est ce qui tient vis-à-vis des règles pub Meta et Google sur une
   promesse de remboursement. */
.guarantee-links{display:flex;gap:18px;align-items:center;flex-wrap:wrap}
.guarantee-links .anchor{
  display:inline-block;padding:.95em 1.6em;text-decoration:none;
  font-family:var(--mono);font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--ink);background:#F4F2F7;border-radius:.85em;
  box-shadow:0 0 0 1px rgba(181,123,255,.45),0 12px 30px -14px rgba(0,0,0,.75);
  transition:transform .22s var(--ease-micro,ease),box-shadow .22s ease,background .22s ease;
}
.guarantee-links .anchor:hover{
  background:#fff;transform:translateY(-1px);
  box-shadow:0 0 0 1px rgba(181,123,255,.7),0 16px 36px -14px rgba(0,0,0,.8);
}
.guarantee-links .anchor:active{transform:translateY(0)}
.guarantee-links .anchor:focus-visible{outline:2px solid var(--glow);outline-offset:3px}

/* ── Footer ───────────────────────────────────────────────────────────── */
.footer{position:relative;z-index:2;background:var(--ink-panel);padding:22px 20px 36px}
.footer-in{max-width:1180px;margin:0 auto;border-top:1px solid rgba(244,241,248,.12);padding-top:20px}
.footer-row{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:12.5px;color:rgba(244,241,248,.6)}
.footer-links{display:flex;gap:18px;flex-wrap:wrap}
.footer a{color:rgba(244,241,248,.72);text-decoration:underline;text-underline-offset:3px}
.footer a:hover{color:#fff}
.footer-legal{margin:12px 0 0;font-size:11.5px;line-height:1.6;color:rgba(244,241,248,.5)}

/* ── Entrée du hero : masque par ligne ────────────────────────────────── */
.ln{display:block;overflow:hidden;white-space:nowrap}
.ln-i{display:block;transform:translateY(112%);will-change:transform}
.is-in .ln-i{transform:translateY(0);transition:transform .78s var(--ease-in-out)}
.headline .ln:nth-child(2) .ln-i{transition-delay:85ms}
.headline .ln:nth-child(3) .ln-i{transition-delay:170ms}
.promise .ln:nth-child(1) .ln-i{transition-delay:250ms}
.promise .ln:nth-child(2) .ln-i{transition-delay:315ms}
/* Selecteurs plus specifiques que les etats d'entree .js poses plus bas :
   a specificite egale, c'est l'ordre source qui gagnerait, et le contenu
   resterait invisible. */
.hero-inner.is-in .pre-in{opacity:1;transform:none;transition:opacity .6s var(--ease-in-out),transform .6s var(--ease-in-out)}
.hairline{transition:transform .8s var(--ease-in-out) .5s}
.hero-inner.is-in .hairline{transform:scaleX(1)}
/* Etats d'entree conditionnes a .js : sans JavaScript, ou si le script casse,
   la page reste entierement lisible au lieu de rester a opacity 0. */
.js [data-reveal]{opacity:0;transform:translateY(22px)}
.js [data-reveal].shown{opacity:1;transform:none;transition:opacity .6s var(--ease-in-out),transform .6s var(--ease-in-out)}
.js .pre-in{opacity:0;transform:translateY(14px)}
.js .hairline{transform:scaleX(0)}

/* ── Breakpoints ──────────────────────────────────────────────────────── */
@media(min-width:1000px){
  /* La vidéo et le formulaire commencent à la même hauteur : le haut du widget
     est visible dès l'arrivée sur la page, sans aucun scroll.
     La piste du formulaire est bornée : jamais moins de 420px (iClosed garde
     une mise en page confortable) et jamais plus de 540px (au delà, le widget
     s'étire pour rien et la vidéo rétrécit). */
  .convert-grid{grid-template-columns:minmax(0,1fr) clamp(420px,42%,540px)}
  .video-col{position:sticky;top:20px}
}
@media(max-width:999px){
  #iclosed-mount{min-height:840px}
}
/* Tablette portrait : en colonne unique, une vidéo pleine largeur pousserait
   le formulaire hors de l'écran. On borne la colonne. */
@media(min-width:700px) and (max-width:999px){
  .convert-grid{max-width:680px;margin:0 auto}
}
/* Mobile : chaque pixel compte, le haut de la carte iClosed doit rester
   au dessus de la pliure d'un iPhone 13 (environ 660px utiles dans Safari). */
@media(max-width:700px){
  .hero{padding:46px 18px 11px}
  .topbar{height:48px;padding:0 18px}
  .logo{width:34px;height:34px;border-radius:10px}
  .headline{margin-top:.24em;line-height:1.1}
  .promise{margin-top:.52em}
  .hairline{margin-top:12px}
  .trust{margin-top:9px;font-size:12px}
  .convert{padding:12px 18px 56px}
  .convert-grid{gap:14px}
  .col-head{margin-bottom:9px;font-size:14.5px;line-height:1.25}
  .card-head{padding:13px 15px 11px;font-size:14.5px;line-height:1.25}
  /* La façade n'est qu'un poster : en 2:1 elle rend 22px à la pliure. Le
     lecteur reprend le 16:9 au clic, et un décalage qui suit une interaction
     de moins de 500ms n'entre pas dans le CLS. */
  .player{aspect-ratio:2/1}
  #iclosed-mount{min-height:900px;padding:12px 8px 8px}
}
/* iPhone SE et assimilés : la marge est nulle, on resserre encore. */
@media(max-width:380px){
  .hero{padding:42px 16px 9px}
  .hairline{margin-top:10px}
  .trust{margin-top:7px}
  .convert{padding:10px 16px 48px}
  .convert-grid{gap:12px}
  .col-head{margin-bottom:8px;font-size:14px}
  .card-head{padding:12px 14px 10px;font-size:14px}
}
@media(prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
  html{scroll-behavior:auto}
  .ln-i{transform:none}
  .hairline{transform:scaleX(1)}
  .pre-in,[data-reveal]{opacity:1;transform:none}
}
</style>
</head>

<body>
<div class="page">
  <div class="grain" aria-hidden="true"></div>

  <header class="topbar">
    <!-- Le logo, redessiné en SVG d'après le fichier fourni : tuile de verre
         violette, sphère noire brillante, halo magenta, faisceau vertical.
         Dès que assets/logo.png est déposé, la page bascule seule sur le
         fichier d'origine, sans rien modifier ici. -->
    <div class="logo" id="logo">
      <svg viewBox="0 0 80 80" role="img" aria-label="Reset Ultra" focusable="false">
        <defs>
          <linearGradient id="ru-tile" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#453058"/>
            <stop offset="55%" stop-color="#2A1B3D"/>
            <stop offset="100%" stop-color="#3A2550"/>
          </linearGradient>
          <radialGradient id="ru-halo" cx="50%" cy="50%" r="50%">
            <stop offset="58%" stop-color="#E879F9" stop-opacity="0"/>
            <stop offset="76%" stop-color="#E879F9" stop-opacity=".95"/>
            <stop offset="88%" stop-color="#b57bff" stop-opacity=".35"/>
            <stop offset="100%" stop-color="#b57bff" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="ru-sphere" cx="42%" cy="26%" r="82%">
            <stop offset="0" stop-color="#2B2337"/>
            <stop offset="42%" stop-color="#100A18"/>
            <stop offset="100%" stop-color="#05030A"/>
          </radialGradient>
          <linearGradient id="ru-gloss" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#CFC6E4" stop-opacity=".5"/>
            <stop offset="100%" stop-color="#CFC6E4" stop-opacity="0"/>
          </linearGradient>
          <linearGradient id="ru-beam" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#F5D0FE"/>
            <stop offset="100%" stop-color="#b57bff" stop-opacity="0"/>
          </linearGradient>
          <!-- RU-1P-DIFF — le trait blanc du logo officiel : plein au centre,
               il s'éteint aux deux extrémités comme sur le favicon. -->
          <linearGradient id="ru-trait" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#FFFFFF" stop-opacity=".25"/>
            <stop offset="30%" stop-color="#FFFFFF"/>
            <stop offset="70%" stop-color="#FFFFFF"/>
            <stop offset="100%" stop-color="#FFFFFF" stop-opacity=".25"/>
          </linearGradient>
          <filter id="ru-soft" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="1.6"/>
          </filter>
        </defs>
        <rect x="1" y="1" width="78" height="78" rx="22" fill="url(#ru-tile)"/>
        <rect x="1.6" y="1.6" width="76.8" height="76.8" rx="21.6" fill="none" stroke="#C9BEDE" stroke-opacity=".45"/>
        <circle cx="40" cy="37" r="27" fill="url(#ru-halo)" filter="url(#ru-soft)"/>
        <rect x="38.8" y="55" width="2.4" height="22" rx="1.2" fill="url(#ru-beam)" filter="url(#ru-soft)"/>
        <circle cx="40" cy="37" r="21" fill="url(#ru-sphere)"/>
        <ellipse cx="38" cy="24" rx="13" ry="7" fill="url(#ru-gloss)"/>
      </svg>
    </div>
  </header>

  <!-- ══ Hero ═══════════════════════════════════════════════════════════ -->
  <section class="hero" id="hero">
    <div class="fx star star-1" aria-hidden="true"></div>
    <div class="fx star star-2" aria-hidden="true"></div>
    <div class="fx star star-3" aria-hidden="true"></div>

    <!-- RU-1P-AURORE-RETIREE (28/07, demande Djibril : « tu peux enlever
         toute l'aurore »). Le hero ne repose plus sur un décor mais sur sa
         typographie. Anneau SVG, trame de points, lavis et rubans vidéo Kling
         supprimés — spec conservée dans reset-ultra-temoignages/PASSATION-AURORE-ET-TEMOIGNAGES.md. -->
    

    <div class="hero-inner" id="hero-inner">
      <p class="eyebrow pre-in">Pour le cadre ou le diplômé qui veut enfin sa liberté</p>
      <!-- Coupes de lignes figées, identiques à la page de référence : 3 lignes
           pour le titre, 2 pour la garantie, de l'iPhone SE au grand écran. -->
      <h1 class="headline" id="headline"><span class="ln"><span class="ln-i">Est-Il Possible De Générer <span class="hl">Entre 3,000 À</span></span></span><span class="ln"><span class="ln-i"><span class="hl">5,000 Euros</span> Par Mois Depuis Chez Soi Grâce</span></span><span class="ln"><span class="ln-i">Au Business <span class="hl hl-serif">Le Plus Vieux D'Internet</span>&nbsp;?</span></span></h1>
      <p class="promise" id="promise"><span class="ln"><span class="ln-i">+ Si Tu N'as Pas Fait 5,000 Euros Sur Les 90</span></span><span class="ln"><span class="ln-i">Prochains Jours, <span class="garantie-hl">Je Te Rembourse</span> <span class="fine">(sur contrat)</span></span></span></p>
      <div class="hairline" aria-hidden="true"></div>
      <p class="trust pre-in">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span class="sep" aria-hidden="true"></span>
        <span>+83 résultats clients</span>
      </p>
      <!-- RU-1P-VITRINE : la vitrine de visages, montée en JS après le load
           pour ne pas disputer la bande passante au premier rendu. -->
      <div class="vitrine" id="vitrine" aria-hidden="true"></div>
    </div>
  </section>

  <!-- ══ Conversion : la vidéo et le formulaire côte à côte ═════════════ -->
  <section class="convert" id="booking">
    <!-- Le faisceau part de la tuile du logo et se pose sur l'arête du panneau.
         Sa hauteur est calculée en JS, il reste juste à toutes les largeurs. -->
    <div class="beam" id="beam" aria-hidden="true">
      <span class="beam-line"></span>
      <span class="beam-glow"></span>
      <span class="beam-hit"></span>
    </div>
    <div class="wrap convert-grid">
      <div class="video-col">
        <h2 class="col-head vid-head">Ne me croyez pas&nbsp;! Cliquez sur la vidéo avant de réserver votre appel&nbsp;:</h2>
        <div class="player-wrap">
          <div class="player-glow" aria-hidden="true"></div>
          <div class="player-frame">
            <div class="player" id="player">
              <!-- REMPLACER : poster de la VSL, AVIF ou WebP, width/height explicites.
                   L'embed ne charge qu'au clic (façade), le lien va dans VSL_EMBED_URL. -->
              <div class="slot">Poster de la VSL</div>
              <div class="poster-shade" aria-hidden="true"></div>
              <button class="play-btn" id="play-btn" type="button" aria-label="Lancer la vidéo">
                <span class="play-dot" aria-hidden="true">▶</span>
              </button>
              <span class="player-time" id="player-time">12:04</span>
            </div>
          </div>
        </div>
      </div>

      <div class="form-col">
        <div class="booking-card">
          <h2 class="card-head">Entrez vos informations pour voir s'il reste des créneaux&nbsp;:</h2>
          <div id="iclosed-mount">
            <div class="iclosed-widget"
                 data-url="https://app.iclosed.io/e/djibrilsylearning/reset-1-to1"
                 data-title="Reset Ultra, appel 1:1"
                 style="width:100%;min-height:700px"></div>
          </div>
          <!-- Secours : masqué, révélé seulement si aucune iframe après 8 s. -->
          <div class="iclosed-fallback" id="iclosed-fallback">
            <p>Le module de réservation ne s'affiche pas&nbsp;?
              <a href="https://app.iclosed.io/e/djibrilsylearning/reset-1-to1">Ouvre le formulaire ici</a>
            </p>
          </div>
          <p class="rgpd">Vos informations servent uniquement à organiser l'appel. Elles ne sont ni vendues ni cédées. <a href="confidentialite.html">Politique de confidentialité</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ Preuves ════════════════════════════════════════════════════════ -->
  <section class="proofs" id="preuves">
    <div class="proofs-head">
      <h2 data-reveal>+83 RÉSULTATS CLIENTS&nbsp;:</h2>
    </div>
    <!-- Témoignages empilés, les uns sous les autres. -->
    <div class="stack" id="stack"></div>
  </section>

  <!-- ══ Questions, puis garantie. Volontairement en bas de page. ═══════ -->
  <section class="slab">
    <div class="slab-ray" aria-hidden="true"></div>
    <div class="slab-inner">
      <div class="faq">
        <h2 data-reveal>Les questions qu'on me pose avant l'appel</h2>

        <!-- À VALIDER PAR DJIBRIL : les réponses ci-dessous sont des
             formulations de travail. Rien ne doit promettre un revenu au delà
             de la garantie déjà affichée (conformité pubs Google et Meta). -->

        <!-- À REMPLIR, C'EST LE PLUS IMPORTANT : la page ne dit jamais de quel
             business il s'agit. Pour un ingénieur sceptique c'est un frein, et
             pour la règle Google « Déclarations trompeuses » sur une page de
             génération de leads, dissimuler la nature de l'offre est un motif
             de refus. Nomme l'activité en clair dans la réponse ci-dessous. -->
        <div class="qa" data-reveal>
          <h3>C'est quoi, le business le plus vieux d'Internet&nbsp;?</h3>
          <p>À compléter par Djibril : nommer l'activité en clair, en une ou deux phrases, sans détour.</p>
        </div>
        <div class="qa" data-reveal>
          <h3>Je suis en poste, j'ai le temps pour ça&nbsp;?</h3>
          <p>C'est le cas de la quasi totalité des gens que j'accompagne. Le plan est construit autour d'un emploi du temps de salarié, sur les soirées et une partie du week end. On fixe le rythme réel pendant l'appel, pas un rythme théorique.</p>
        </div>
        <div class="qa" data-reveal>
          <h3>Ça marche si je pars de zéro&nbsp;?</h3>
          <p>Oui, c'est même le point de départ le plus fréquent. Aucune compétence technique n'est demandée au démarrage. Ce qui compte, c'est de suivre le plan dans l'ordre et de tenir le rythme fixé.</p>
        </div>
        <div class="qa" data-reveal>
          <h3>Comment se passe l'appel&nbsp;?</h3>
          <p>Un point en direct, sans présentation ni diaporama. On regarde ta situation, ce que tu peux dégager comme temps, et si la méthode est adaptée à ton cas. Si ce n'est pas adapté, je te le dis pendant l'appel.</p>
        </div>
        <div class="qa" data-reveal>
          <h3>Comment marche la garantie&nbsp;?</h3>
          <p>Tu appliques le plan et tu fournis tes livrables sur les 90 jours. Si le résultat n'est pas là au 90e jour, tu récupères ton investissement. Les conditions exactes sont dans le contrat signé avant le démarrage, et résumées dans les <a href="mentions-legales.html">mentions légales</a>.</p>
        </div>
      </div>

      <div class="guarantee" data-reveal>
        <div class="seal">
          <span class="seal-n">90</span>
          <span class="seal-u">JOURS</span>
        </div>
